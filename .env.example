# Configuración para desarrollo local
# =============================================
# Este archivo es SOLO UNA PLANTILLA de referencia.
# NO contiene valores reales por seguridad.

# Supabase Configuration (para desarrollo local)
# IMPORTANTE: Estas variables SOLO funcionan en desarrollo local
# En Lovable/producción, los valores están en src/integrations/supabase/client.ts

VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Sentry (optional - only needed for production error monitoring)
VITE_SENTRY_DSN=

# Notas importantes para colaboradores:
# 1. Copia este archivo como .env para desarrollo local
# 2. Solicita las credenciales reales al administrador del proyecto
# 3. NUNCA subas el archivo .env real al repositorio (ya está en .gitignore)
# 4. Las credenciales de Supabase (URL y ANON KEY) son públicas y seguras de exponer
# 5. La seguridad real está en las Row Level Security (RLS) policies de Supabase
# 6. Las API keys sensibles (OpenAI, etc.) están en Supabase Secrets (backend)