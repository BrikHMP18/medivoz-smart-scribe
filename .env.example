# Supabase Configuration
# Obtén estos valores del dashboard de Supabase: https://supabase.com/dashboard/project/[project-id]/settings/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Nota: Este archivo es solo un ejemplo. 
# Las credenciales reales se configuran directamente en el cliente de Supabase.
# Para desarrolladores: copien este archivo como .env y configuren los valores reales.